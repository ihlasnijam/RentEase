<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <!-- Back -->
        <LinearLayout android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="←" android:textSize="18sp" android:textColor="@color/blue_primary" android:layout_marginEnd="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back" android:textSize="14sp" android:textColor="@color/blue_primary" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Report an issue" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/navy" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select up to 2 categories and describe the issue" android:textSize="13sp" android:textColor="@color/text_muted" android:layout_marginBottom="20dp" />

        <!-- Category label -->
        <TextView android:id="@+id/tvCategoryLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATEGORY (select 1 or 2)" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="10dp" />

        <!-- Category row 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="8dp">
            <TextView android:id="@+id/catPlumbing"   android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🔧 Plumbing"   android:textSize="11sp" android:textColor="@color/text_muted" android:background="@drawable/bg_stat_card" android:gravity="center" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/catElectrical" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="⚡ Electrical" android:textSize="11sp" android:textColor="@color/text_muted" android:background="@drawable/bg_stat_card" android:gravity="center" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/catHVAC"       android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="❄️ HVAC / AC"  android:textSize="11sp" android:textColor="@color/text_muted" android:background="@drawable/bg_stat_card" android:gravity="center" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <!-- Category row 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="20dp">
            <TextView android:id="@+id/catAppliances" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🏠 Appliances" android:textSize="11sp" android:textColor="@color/text_muted" android:background="@drawable/bg_stat_card" android:gravity="center" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/catStructural" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🧱 Structural" android:textSize="11sp" android:textColor="@color/text_muted" android:background="@drawable/bg_stat_card" android:gravity="center" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/catOther"      android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="📋 Other"      android:textSize="11sp" android:textColor="@color/text_muted" android:background="@drawable/bg_stat_card" android:gravity="center" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <!-- Location -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCATION" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="10dp" />
        <Spinner android:id="@+id/spinnerLocation" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_input" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_marginBottom="20dp" />

        <!-- Description -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DESCRIPTION" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="10dp" />
        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:hint="Describe the issue in detail..."
            android:textSize="14sp"
            android:textColor="@color/navy"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="20dp" />

        <!-- Priority — Low is GREEN, Medium is AMBER, Urgent is RED -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRIORITY" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="20dp">

            <!-- Low — green text on white/green bg — explicitly NOT white text -->
            <TextView
                android:id="@+id/priLow"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Low"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/green_dark"
                android:background="@drawable/bg_badge_green"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Medium — amber, default selected -->
            <TextView
                android:id="@+id/priMedium"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Medium"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/amber_dark"
                android:background="@drawable/bg_badge_amber"
                android:gravity="center"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Urgent — red -->
            <TextView
                android:id="@+id/priUrgent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Urgent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:background="@drawable/bg_stat_card"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Photo upload -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PHOTO (optional)" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/text_muted" android:layout_marginBottom="10dp" />
        <LinearLayout
            android:id="@+id/uploadBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_upload"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📷" android:textSize="28sp" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/tvUploadLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to attach a photo" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/blue_primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JPG or PNG — helps landlord assess the issue" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageView android:id="@+id/imgPreview" android:layout_width="match_parent" android:layout_height="160dp" android:scaleType="centerCrop" android:layout_marginBottom="20dp" android:visibility="gone" />

        <ProgressBar android:id="@+id/pbSubmit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:indeterminateTint="@color/blue_primary" android:layout_marginBottom="12dp" android:visibility="gone" />

        <TextView android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="52dp" android:text="Submit request" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/white" android:background="@drawable/bg_button_primary" android:gravity="center" android:clickable="true" android:focusable="true" />

    </LinearLayout>

</ScrollView>
